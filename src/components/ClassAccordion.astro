---
import { Image } from "astro:assets";

interface Pricing {
    sessions: string;
    duration: string;
    priceIDR: string;
    priceUSD: string;
    desc: string;
}

interface Props {
    title: string;
    image: any;
    description: string;
    pricing: Pricing[];
    included: string[];
    whoIsItFor: string[];
    whatToBring: string[];
    waLink: string;
}

const { title, image, description, pricing, included, whoIsItFor, whatToBring, waLink } = Astro.props;
---

<class-accordion class="block bg-white rounded-none shadow-xl overflow-hidden mb-6">
    <!-- ACCORDION HEADER (Clickable) -->
    <button class="accordion-header w-full flex flex-col md:flex-row items-stretch text-left hover:bg-gray-50 transition-all duration-300 relative focus:outline-none group">
        <!-- Image Section -->
        <div class="w-full md:w-1/3 aspect-[4/3] md:aspect-auto md:h-auto min-h-[12rem] overflow-hidden relative">
            <Image src={image} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
        </div>
        
        <!-- Header Text Section -->
        <div class="w-full md:w-2/3 p-6 md:p-8 flex justify-between items-center bg-white">
            <div class="pr-6">
                <h2 class="text-3xl md:text-5xl font-bebas font-bold text-[#093C5D] tracking-wide mb-2 uppercase">{title}</h2>
                <p class="text-gray-600 text-sm md:text-base leading-relaxed line-clamp-2 md:line-clamp-none">{description}</p>
            </div>
            
            <!-- PERUBAHAN ICON: Saat di-hover background jadi yellow-400 -->
            <div class="flex-shrink-0 text-[#093C5D] accordion-icon transition-all duration-300 bg-gray-100 p-2 rounded-full group-hover:bg-yellow-400 group-hover:shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
        </div>
    </button>

    <!-- ACCORDION BODY (Expandable) -->
    <div class="accordion-body transition-[grid-template-rows] duration-500 ease-in-out">
        <div class="overflow-hidden">
            <div class="p-6 md:p-10 bg-[#f9fafa] border-t-2 border-gray-100 relative">
                
                <div class="absolute top-0 right-10 w-16 h-2 bg-yellow-400"></div>

                <!-- PRICING CARDS -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    {pricing.map((priceItem) => (
                        <div class="bg-white p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300 relative group">
                            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#2E6FA0] group-hover:bg-yellow-400 transition-colors duration-300"></div>
                            
                            <h3 class="text-3xl font-bebas font-bold text-[#093C5D] tracking-wide mb-3">{priceItem.sessions}</h3>
                            
                            <!-- PERUBAHAN HARGA: Menambahkan badge IDR dan USD bersebelahan -->
                            <div class="flex flex-wrap items-center gap-2 mb-4">
                                <span class="bg-gray-100 text-gray-700 px-2 py-1 text-xs font-bold uppercase tracking-wider">{priceItem.duration}</span>
                                <span class="bg-[#093C5D] text-white px-2 py-1 text-xs font-bold uppercase tracking-wider">{priceItem.priceIDR}</span>
                                <span class="bg-yellow-400 text-[#093C5D] px-2 py-1 text-xs font-bold uppercase tracking-wider">{priceItem.priceUSD}</span>
                            </div>
                            
                            <p class="text-gray-500 text-sm leading-relaxed">{priceItem.desc}</p>
                        </div>
                    ))}
                </div>

                <!-- DETAILS GRID -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- What's Included -->
                    <div>
                        <h4 class="text-2xl font-bebas font-bold text-slate-800 tracking-wide mb-4 flex items-center gap-2">
                            <svg class="w-6 h-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            What's Included
                        </h4>
                        <ul class="space-y-3">
                            {included.map((item) => (
                                <li class="text-sm text-gray-600 flex items-start gap-3">
                                    <span class="text-green-500 font-bold flex-shrink-0">✓</span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                    
                    <!-- Who is this for -->
                    <div>
                        <h4 class="text-2xl font-bebas font-bold text-slate-800 tracking-wide mb-4 flex items-center gap-2">
                            <svg class="w-6 h-6 text-[#2E6FA0]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            Who Is This For?
                        </h4>
                        <ul class="space-y-3">
                            {whoIsItFor.map((item) => (
                                <li class="text-sm text-gray-600 flex items-center gap-3">
                                    <span class="w-2 h-2 bg-gray-300 rounded-full flex-shrink-0"></span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>

                    <!-- What To Bring -->
                    <div>
                        <h4 class="text-2xl font-bebas font-bold text-slate-800 tracking-wide mb-4 flex items-center gap-2">
                            <svg class="w-6 h-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            What To Bring
                        </h4>
                        <ul class="space-y-3">
                            {whatToBring.map((item) => (
                                <li class="text-sm text-gray-600 flex items-center gap-3">
                                    <span class="w-2 h-2 bg-gray-300 rounded-full flex-shrink-0"></span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                <!-- BOOK NOW BUTTON -->
                <div class="mt-12 pt-8 border-t border-gray-200 text-center md:text-left">
                    <a href={`${waLink}?text=Hi%20Backwash%20Surf,%20I'm%20interested%20in%20booking%20the%20${encodeURIComponent(title)}`} target="_blank" class="inline-flex items-center justify-center gap-3 bg-[#093C5D] text-white px-10 py-4 font-bebas text-2xl tracking-wider hover:bg-yellow-400 hover:text-slate-900 transition-all duration-300 shadow-md w-full md:w-auto">
                        <span>Book This Class Now</span>
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>
                </div>
                
            </div>
        </div>
    </div>
</class-accordion>

<style>
    .accordion-body {
        display: grid;
        grid-template-rows: 0fr;
    }
    .accordion-body.is-open {
        grid-template-rows: 1fr;
    }
    .accordion-icon.is-open {
        transform: rotate(45deg);
        color: #ef4444; 
        background-color: #fee2e2; 
    }
</style>

<script>
    class ClassAccordion extends HTMLElement {
        connectedCallback() {
            const header = this.querySelector('.accordion-header');
            const body = this.querySelector('.accordion-body');
            const icon = this.querySelector('.accordion-icon');

            header?.addEventListener('click', () => {
                body?.classList.toggle('is-open');
                icon?.classList.toggle('is-open');
            });
        }
    }
    
    if (!customElements.get('class-accordion')) {
        customElements.define('class-accordion', ClassAccordion);
    }
</script>