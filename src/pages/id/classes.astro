---
import Layout from "../../layouts/Layout.astro";
import ClassAccordion from "../../components/ClassAccordion.astro";

import foto6Image from "../../assets/foto6.jpeg";
import foto1Image from "../../assets/foto1.jpeg";
import foto5Image from "../../assets/foto5.jpeg";
import foto10Image from "../../assets/foto10.jpeg";

const waLink = "https://wa.me/6282323128661";

const classesData = [
    {
        title: "KURSUS PRIVAT (PEMULA)",
        image: foto6Image,
        description: "Sangat cocok untuk pemula yang baru pertama kali berselancar. Dapatkan perhatian penuh 1-lawan-1 untuk membangun kepercayaan diri, mempelajari dasar-dasar, dan berdiri di atas ombak pertama Anda dengan aman.",
        pricing: [
            { sessions: "MULAI DARI", duration: "1 Sesi", priceIDR: "450K IDR", priceUSD: "Hubungi Kami", desc: "Untuk informasi lebih lanjut mengenai sesi, paket multi-hari, dan ketersediaan jadwal, silakan hubungi kami lebih lanjut di WhatsApp." }
        ],
        included: ["Instruktur selancar profesional (1-on-1)", "Teori & pengarahan keselamatan", "Papan selancar & Pakaian Renang (Rashguard)", "Air minum", "Pemanasan di pantai"],
        whoIsItFor: ["Peselancar pemula", "Pemula", "Pelancong solo"],
        whatToBring: ["Pakaian renang", "Handuk", "Tabir surya", "Energi positif!"]
    },
    {
        title: "KURSUS PRIVAT (TINGKAT MENENGAH)",
        image: foto10Image,
        description: "Sudah menguasai dasar-dasarnya? Sesi privat 1-lawan-1 ini berfokus pada peningkatan teknik mendayung, membaca ombak, berbelok, dan memantapkan teknik berselancar Anda secara keseluruhan.",
        pricing: [
            { sessions: "MULAI DARI", duration: "1 Sesi", priceIDR: "450K IDR", priceUSD: "Hubungi Kami", desc: "Untuk informasi lebih lanjut mengenai sesi, paket multi-hari, dan ketersediaan jadwal, silakan hubungi kami lebih lanjut di WhatsApp." }
        ],
        included: ["Instruktur selancar profesional (1-on-1)", "Analisis pembacaan ombak", "Papan selancar & Pakaian Renang (Rashguard)", "Air minum", "Umpan balik teknik tingkat lanjut"],
        whoIsItFor: ["Peselancar tingkat menengah", "Peselancar yang ingin naik level", "Pelancong solo"],
        whatToBring: ["Pakaian renang", "Handuk", "Tabir surya", "Energi positif!"]
    },
    {
        title: "KURSUS BERSAMA (2 ORANG)",
        image: foto1Image,
        description: "Berbagi keseruan dengan pasangan atau sahabat terbaik Anda! Pengalaman belajar yang menyenangkan dan interaktif dengan bimbingan personal dari satu instruktur.",
        pricing: [
            { sessions: "MULAI DARI", duration: "1 Sesi", priceIDR: "750K IDR", priceUSD: "Hubungi Kami", desc: "Untuk informasi lebih lanjut mengenai sesi, paket multi-hari, dan ketersediaan jadwal, silakan hubungi kami lebih lanjut di WhatsApp." }
        ],
        included: ["1 Pelatih profesional untuk 2 orang", "Teori & pengarahan keselamatan", "Papan selancar & Pakaian Renang (Rashguard)", "Air minum", "Umpan balik bersama"],
        whoIsItFor: ["Pasangan", "Teman seperjalanan", "Saudara"],
        whatToBring: ["Pakaian renang", "Handuk", "Tabir surya", "Energi positif!"]
    },
    {
        title: "KURSUS BERSAMA GRUP",
        image: foto5Image,
        description: "Liburan bersama rombongan teman atau keluarga? Tangkap ombak bersama dalam suasana yang menyenangkan, aman, dan ramah bersama instruktur berpengalaman kami.",
        pricing: [
            { sessions: "MULAI DARI", duration: "1 Sesi", priceIDR: "750K IDR", priceUSD: "Hubungi Kami", desc: "Untuk informasi lebih lanjut mengenai sesi, paket multi-hari, dan ketersediaan jadwal, silakan hubungi kami lebih lanjut di WhatsApp." }
        ],
        included: ["Instruktur selancar profesional", "Teori & pengarahan keselamatan grup", "Papan selancar & Pakaian Renang (Rashguard)", "Air minum", "Pemanasan di pantai"],
        whoIsItFor: ["Keluarga", "Rombongan teman", "Backpacker"],
        whatToBring: ["Pakaian renang", "Handuk", "Tabir surya", "Energi positif!"]
    }
];
---

<Layout title="Kelas - Backwash Surf Bali">
    <main class="font-sans pt-32 bg-[#093C5D] min-h-screen flex flex-col">
        
        <!-- HEADER PAGE -->
        <div class="text-center mb-16 px-6">
            <h1 class="text-6xl md:text-8xl font-bebas font-bold text-white uppercase tracking-wider mb-4 drop-shadow-md">
                Kelas Selancar Kami
            </h1>
            <p class="text-gray-200 max-w-xl mx-auto text-base md:text-lg">
                Pilih paket terbaik untuk tingkat pengalaman Anda. Klik pada setiap kelas untuk melihat harga dan detailnya!
            </p>
        </div>

        <!-- ACCORDION CLASSES LIST -->
        <section id="classes-list" class="w-full max-w-6xl mx-auto px-4 md:px-8 flex flex-col gap-6 flex-grow pb-24">
            {classesData.map((cls) => (
                <ClassAccordion 
                    title={cls.title}
                    image={cls.image}
                    description={cls.description}
                    pricing={cls.pricing}
                    included={cls.included}
                    whoIsItFor={cls.whoIsItFor}
                    whatToBring={cls.whatToBring}
                    waLink={waLink}
                />
            ))}
        </section>

        <!-- HOW TO ORDER SECTION -->
        <section class="w-full bg-[#f4f8fa] py-24 px-6 md:px-12">
            <div class="max-w-6xl mx-auto text-center">
                <h2 class="text-5xl md:text-6xl font-bebas font-bold text-[#093C5D] uppercase tracking-wider mb-12">
                    Cara Memesan
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 text-left">
                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">01</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Pilih Kelas Anda</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Jelajahi paket selancar kami di atas. Apakah Anda menginginkan sesi privat atau pelajaran kelompok yang menyenangkan, pilih yang sesuai dengan suasana dan tingkat keahlian Anda.
                        </p>
                    </div>

                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">02</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Pesan & Booking</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Klik tombol "Pesan Kelas Ini" untuk mengamankan tempat Anda melalui WhatsApp secara mudah, atau hubungi kami langsung jika Anda memiliki pertanyaan sebelum memesan.
                        </p>
                    </div>

                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">03</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Bersiap Berselancar</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Setelah jadwal Anda dikonfirmasi oleh tim kami, cukup siapkan tabir surya dan bawa energi positif Anda. Kami akan menemui Anda di pantai!
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
                    <a href="https://wa.me/6282323128661" target="_blank" class="inline-block bg-[#093C5D] text-white px-10 py-4 font-bebas text-2xl tracking-wider hover:bg-yellow-400 hover:text-slate-900 transition-colors duration-300 shadow-md w-full sm:w-auto">
                        Konsultasi via WhatsApp
                    </a>
                    <a href="#classes-list" class="inline-block bg-white text-[#093C5D] border-2 border-[#093C5D] px-10 py-4 font-bebas text-2xl tracking-wider hover:bg-gray-50 transition-colors duration-300 shadow-md w-full sm:w-auto">
                        Lihat Kelas Lagi
                    </a>
                </div>
            </div>
        </section>
        
    </main>
</Layout>