            { sessions: "1 Pelajaran", duration: "2 jam", priceIDR: "400K IDR / orang", priceUSD: "$22 USD / orang", desc: "Tangkap ombak pertama Anda bersama dan nikmati pengalaman berbagi yang menyenangkan." },
