        pricing: [
            { sessions: "Paket Lengkap", duration: "7 Hari", priceIDR: "3.000K IDR", priceUSD: "$165 USD", desc: "Pengalaman kamp selancar terbaik tanpa akomodasi. Pelatihan intensif harian." }
        ],
