                textPosition="right"
            />
        </section>

        <!-- SECTION MARQUEE KE-2 -->
        <div
            class="bg-teal-500 py-3 overflow-hidden flex whitespace-nowrap items-center w-full"
        >
            <div
                class="animate-marquee flex whitespace-nowrap text-slate-900 text-3xl md:text-4xl font-handwritten"
            >
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
                <span class="mx-6">Tunggangi Ombakmu Sendiri.</span>
            </div>
        </div>

        <!-- SECTION INSTRUCTORS -->
        <section
            id="instructors-title"
            class="w-full pt-20 md:pt-32 pb-10 bg-white flex flex-col md:flex-row"
        >
            <div
                class="w-full md:w-1/2 flex flex-col justify-center items-center px-6 md:px-12 lg:px-16"
            >
                <h2
                    class="text-[5rem] md:text-[7rem] lg:text-[9rem] xl:text-[11rem] leading-[0.9] tracking-tight font-bebas font-bold text-[#2E6FA0] text-right uppercase w-full max-w-2xl"
