---
import Layout from "../layouts/Layout.astro";
import ClassAccordion from "../components/ClassAccordion.astro";

import foto6Image from "../assets/foto6.jpeg";
import foto1Image from "../assets/foto1.jpeg";
import foto5Image from "../assets/foto5.jpeg";
import foto10Image from "../assets/foto10.jpeg";

const waLink = "https://wa.me/6282323128661";

// PERUBAHAN: Menyesuaikan pricing object menjadi priceIDR dan priceUSD
const classesData = [
    {
        title: "PRIVATE LESSON (BEGINNER)",
        image: foto6Image,
        description: "Perfect for first-timers. Get 1-on-1 attention to build your confidence, learn the basics, and catch your first waves safely.",
        pricing: [
            { sessions: "START FROM", duration: "1 Session", priceIDR: "450K IDR", priceUSD: "Chat Us", desc: "For more information about sessions, multi-day packages, and availability, please contact us further on WhatsApp." }
        ],
        included: ["Professional surf instructor (1-on-1)", "Theory & safety briefing", "Surfboard & Rashguard", "Drinking water", "Beach warm-up"],
        whoIsItFor: ["First-time surfers", "Beginners", "Solo travellers"],
        whatToBring: ["Swimwear", "Towel", "Sunscreen", "Positive energy!"]
    },
    {
        title: "PRIVATE LESSON (INTERMEDIATE)",
        image: foto10Image,
        description: "Already know the basics? This 1-on-1 session focuses on improving your paddling, wave reading, turning, and overall technique.",
        pricing: [
            { sessions: "START FROM", duration: "1 Session", priceIDR: "450K IDR", priceUSD: "Chat Us", desc: "For more information about sessions, multi-day packages, and availability, please contact us further on WhatsApp." }
        ],
        included: ["Professional surf instructor (1-on-1)", "Wave reading analysis", "Surfboard & Rashguard", "Drinking water", "Advanced technique feedback"],
        whoIsItFor: ["Intermediate surfers", "Surfers looking to level up", "Solo travellers"],
        whatToBring: ["Swimwear", "Towel", "Sunscreen", "Positive energy!"]
    },
    {
        title: "SHARED LESSON (2 PEOPLE)",
        image: foto1Image,
        description: "Share the stoke with your partner or best friend! A fun, shared experience with personalized guidance from one instructor.",
        pricing: [
            { sessions: "START FROM", duration: "1 Session", priceIDR: "750K IDR", priceUSD: "Chat Us", desc: "For more information about sessions, multi-day packages, and availability, please contact us further on WhatsApp." }
        ],
        included: ["1 Professional coach for 2 people", "Theory & safety briefing", "Surfboard & Rashguard", "Drinking water", "Shared feedback"],
        whoIsItFor: ["Couples", "Friends travelling together", "Siblings"],
        whatToBring: ["Swimwear", "Towel", "Sunscreen", "Positive energy!"]
    },
    {
        title: "SHARED GROUP LESSON",
        image: foto5Image,
        description: "Traveling with a group or family? Catch waves together in a fun, safe, and social environment with our experienced instructors.",
        pricing: [
            { sessions: "START FROM", duration: "1 Session", priceIDR: "750K IDR", priceUSD: "Chat Us", desc: "For more information about sessions, multi-day packages, and availability, please contact us further on WhatsApp." }
        ],
        included: ["Professional surf instructors", "Theory & group safety briefing", "Surfboard & Rashguard", "Drinking water", "Beach warm-up"],
        whoIsItFor: ["Families", "Groups of friends", "Backpackers"],
        whatToBring: ["Swimwear", "Towel", "Sunscreen", "Positive energy!"]
    }
];
---

<Layout title="Classes - Backwash Surf Bali">
    <main class="font-sans pt-32 bg-[#093C5D] min-h-screen flex flex-col">
        
        <!-- HEADER PAGE -->
        <div class="text-center mb-16 px-6">
            <h1 class="text-6xl md:text-8xl font-bebas font-bold text-white uppercase tracking-wider mb-4 drop-shadow-md">
                Our Surf Classes
            </h1>
            <p class="text-gray-200 max-w-xl mx-auto text-base md:text-lg">
                Choose the best package for your experience level. Click on each class to view pricing and details!
            </p>
        </div>

        <!-- ACCORDION CLASSES LIST -->
        <section id="classes-list" class="w-full max-w-6xl mx-auto px-4 md:px-8 flex flex-col gap-6 flex-grow pb-24">
            {classesData.map((cls) => (
                <ClassAccordion 
                    title={cls.title}
                    image={cls.image}
                    description={cls.description}
                    pricing={cls.pricing}
                    included={cls.included}
                    whoIsItFor={cls.whoIsItFor}
                    whatToBring={cls.whatToBring}
                    waLink={waLink}
                />
            ))}
        </section>

        <!-- HOW TO ORDER SECTION -->
        <section class="w-full bg-[#f4f8fa] py-24 px-6 md:px-12">
            <div class="max-w-6xl mx-auto text-center">
                <h2 class="text-5xl md:text-6xl font-bebas font-bold text-[#093C5D] uppercase tracking-wider mb-12">
                    How To Order
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 text-left">
                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">01</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Pick Your Class</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Explore our surf packages above. Whether you want a private session or a fun group lesson, choose the one that fits your vibe and skill level.
                        </p>
                    </div>

                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">02</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Message & Book</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Click the "Book This Class" button to securely lock in your spot via WhatsApp, or contact us directly if you have any questions before booking.
                        </p>
                    </div>

                    <div class="bg-white p-8 border border-gray-200 shadow-md">
                        <div class="text-[#2E6FA0] font-bebas text-6xl mb-4">03</div>
                        <h3 class="text-2xl font-bold font-bebas text-slate-900 mb-3 tracking-wide uppercase">Get Ready to Surf</h3>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            Once your availability is confirmed by our team, just pack your sunscreen and bring your positive energy. We'll meet you at the beach!
                        </p>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
                    <a href="https://wa.me/6282323128661" target="_blank" class="inline-block bg-[#093C5D] text-white px-10 py-4 font-bebas text-2xl tracking-wider hover:bg-yellow-400 hover:text-slate-900 transition-colors duration-300 shadow-md w-full sm:w-auto">
                        Just Consult via WhatsApp
                    </a>
                    <a href="#classes-list" class="inline-block bg-white text-[#093C5D] border-2 border-[#093C5D] px-10 py-4 font-bebas text-2xl tracking-wider hover:bg-gray-50 transition-colors duration-300 shadow-md w-full sm:w-auto">
                        Browse Classes Again
                    </a>
                </div>
            </div>
        </section>
        
    </main>
</Layout>