---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact Us - Backwash Surf Bali">
    <!-- Mengubah background utama menjadi #093C5D dan teks default menjadi putih -->
    <main
        class="font-sans pt-32 pb-24 bg-[#093C5D] text-white min-h-screen flex flex-col overflow-hidden"
    >
        <!-- HEADER PAGE -->
        <div class="text-center mb-16 px-6">
            <h1
                class="text-6xl md:text-8xl font-bebas font-bold text-white uppercase tracking-wider mb-4 drop-shadow-md"
            >
                Let's Catch Waves
            </h1>
            <p class="text-gray-300 max-w-2xl mx-auto text-base md:text-lg">
                Have questions about our classes, need advice on the best time
                to surf, or ready to book? Reach out to us directly or drop by
                our base at the beach!
            </p>
        </div>

        <!-- CONTACT SECTION GRID -->
        <section
            class="w-full max-w-7xl mx-auto px-6 md:px-12 flex flex-col lg:flex-row gap-12 lg:gap-16 flex-grow items-stretch"
        >
            <!-- LEFT: CONTACT CARDS -->
            <div class="w-full lg:w-5/12 flex flex-col gap-6 justify-center">
                <!-- WhatsApp Card -->
                <a
                    href="https://wa.me/6282323128661"
                    target="_blank"
                    class="group flex items-center p-6 bg-white rounded-sm shadow-lg hover:shadow-2xl transition-all duration-300 relative overflow-hidden transform hover:-translate-y-1"
                >
                    <!-- Animasi Background Kuning saat di-hover -->
                    <div
                        class="absolute inset-0 bg-yellow-400 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"
                    >
                    </div>

                    <div class="relative z-10 flex items-center gap-6">
                        <div
                            class="bg-green-100 text-green-600 p-4 rounded-full group-hover:bg-white transition-colors duration-300 shadow-sm"
                        >
                            <svg
                                class="w-8 h-8"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1Z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M14 14a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1Z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <h3
                                class="text-3xl font-bebas text-[#093C5D] tracking-wide mb-1"
                            >
                                WhatsApp
                            </h3>
                            <p
                                class="text-gray-500 group-hover:text-[#093C5D] transition-colors duration-300 text-sm font-bold"
                            >
                                +62 823-2312-8661
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Instagram Card -->
                <a
                    href="https://www.instagram.com/backwashbali/"
                    target="_blank"
                    class="group flex items-center p-6 bg-white rounded-sm shadow-lg hover:shadow-2xl transition-all duration-300 relative overflow-hidden transform hover:-translate-y-1"
                >
                    <div
                        class="absolute inset-0 bg-yellow-400 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"
                    >
                    </div>

                    <div class="relative z-10 flex items-center gap-6">
                        <div
                            class="bg-pink-100 text-pink-600 p-4 rounded-full group-hover:bg-white transition-colors duration-300 shadow-sm"
                        >
                            <svg
                                class="w-8 h-8"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><rect
                                    x="2"
                                    y="2"
                                    width="20"
                                    height="20"
                                    rx="5"
                                    ry="5"></rect><path
                                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                ></path><line
                                    x1="17.5"
                                    y1="6.5"
                                    x2="17.51"
                                    y2="6.5"></line></svg
                            >
                        </div>
                        <div>
                            <h3
                                class="text-3xl font-bebas text-[#093C5D] tracking-wide mb-1"
                            >
                                Instagram
                            </h3>
                            <p
                                class="text-gray-500 group-hover:text-[#093C5D] transition-colors duration-300 text-sm font-bold uppercase"
                            >
                                @backwashbali
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Facebook Card -->
                <a
                    href="https://www.facebook.com/profile.php?id=61595333434111"
                    target="_blank"
                    class="group flex items-center p-6 bg-white rounded-sm shadow-lg hover:shadow-2xl transition-all duration-300 relative overflow-hidden transform hover:-translate-y-1"
                >
                    <div
                        class="absolute inset-0 bg-yellow-400 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"
                    >
                    </div>

                    <div class="relative z-10 flex items-center gap-6">
                        <div
                            class="bg-blue-100 text-blue-600 p-4 rounded-full group-hover:bg-white transition-colors duration-300 shadow-sm"
                        >
                            <svg
                                class="w-8 h-8"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                                ></path></svg
                            >
                        </div>
                        <div>
                            <h3
                                class="text-3xl font-bebas text-[#093C5D] tracking-wide mb-1"
                            >
                                Facebook
                            </h3>
                            <p
                                class="text-gray-500 group-hover:text-[#093C5D] transition-colors duration-300 text-sm font-bold uppercase"
                            >
                                Backwashbali
                            </p>
                        </div>
                    </div>
                </a>

                <!-- Email Card -->
                <a
                    href="mailto:backwashsurfbali@gmail.com"
                    class="group flex items-center p-6 bg-white rounded-sm shadow-lg hover:shadow-2xl transition-all duration-300 relative overflow-hidden transform hover:-translate-y-1"
                >
                    <div
                        class="absolute inset-0 bg-yellow-400 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"
                    >
                    </div>

                    <div class="relative z-10 flex items-center gap-6">
                        <div
                            class="bg-red-100 text-red-600 p-4 rounded-full group-hover:bg-white transition-colors duration-300 shadow-sm"
                        >
                            <svg
                                class="w-8 h-8"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path
                                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                ></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                        </div>
                        <div>
                            <h3
                                class="text-3xl font-bebas text-[#093C5D] tracking-wide mb-1"
                            >
                                Email
                            </h3>
                            <p
                                class="text-gray-500 group-hover:text-[#093C5D] transition-colors duration-300 text-sm font-bold"
                            >
                                backwashsurfbali@gmail.com
                            </p>
                        </div>
                    </div>
                </a>
            </div>

            <!-- RIGHT: MAP -->
            <div
                class="w-full lg:w-7/12 relative group min-h-[400px] md:min-h-[500px]"
            >
                <!-- Aksen background kotak kuning -->
                <div
                    class="absolute inset-0 bg-yellow-400 translate-x-4 translate-y-4 md:translate-x-6 md:translate-y-6 transition-transform duration-500 group-hover:translate-x-2 group-hover:translate-y-2"
                >
                </div>

                <div
                    class="relative z-10 bg-white p-2 shadow-2xl h-full w-full flex flex-col"
                >
                    <!-- Tag Lokasi -->
                    <div
                        class="absolute top-0 left-0 bg-white text-[#093C5D] font-bebas text-xl md:text-2xl px-6 py-3 z-20 shadow-md transform -translate-y-4 -translate-x-4 border-l-4 border-yellow-400"
                    >
                        Basecamp: Pantai Batu Bolong
                    </div>

                    <!-- iFrame Maps -->
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3944.327500004789!2d115.1313099!3d-8.6603703!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd247004e9e478f%3A0xc31a3b4dd87f3bac!2sBackwash%20Surf%20Bali!5e0!3m2!1sen!2sid!4v1793370736850!5m2!1sen!2sid"
                        width="100%"
                        height="100%"
                        style="border:0; flex-grow: 1;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700"
                    ></iframe>
                </div>
            </div>
        </section>
    </main>
</Layout>
