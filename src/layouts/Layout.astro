---
import '../styles/global.css';
import Header from '../components/Header.astro'; 
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    lang?: string; 
}

// 1. Deteksi otomatis dari URL: jika URL dimulai dengan '/id', maka id. Jika tidak, en.
const pathname = Astro.url.pathname;
const detectedLang = pathname.startsWith('/id') ? 'id' : 'en';

// 2. Gunakan detectedLang sebagai default jika prop lang tidak diisi
const { title, lang = detectedLang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Backwash Surf Bali - Kursus Surfing Terbaik di Bali" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/jpeg" href="/logo.jpeg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-white text-slate-900 font-bebas tracking-wide antialiased relative">
        
        <!-- Header sekarang otomatis menerima lang yang benar ("id" atau "en") -->
        <Header lang={lang} />

        <slot />

        <Footer />

        <script>
            import Lenis from 'lenis';

            const lenis = new Lenis({
                autoRaf: true, 
                duration: 1.2, 
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
            });
        </script>
    </body>
</html>